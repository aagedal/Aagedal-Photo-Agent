<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Only generated installed-helper fixtures are shared with the external
         test launcher. XCTest's runner keeps its generated sandbox entitlements. -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/private/tmp/apa-installed-qualification/</string>
    </array>
</dict>
</plist>
